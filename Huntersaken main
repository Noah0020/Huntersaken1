local function httpGet(url)
	local ok, res = pcall(function() return game:HttpGet(url, true) end)
	if ok and type(res) == "string" and #res > 0 then return res end
	if syn and syn.request then
		local ok2, res2 = pcall(function() return syn.request({ Url = url, Method = "GET" }).Body end)
		if ok2 and type(res2) == "string" and #res2 > 0 then return res2 end
	end
	if request then
		local ok3, res3 = pcall(function() return request({ Url = url, Method = "GET" }).Body end)
		if ok3 and type(res3) == "string" and #res3 > 0 then return res3 end
	end
	return nil
end

