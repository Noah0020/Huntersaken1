-- HELPERS
local function getRoot(m)
	return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart)
end

local function folderKids(name)
	local f = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild(name)
	if not f then return {} end
	local t = {}
	for _, c in ipairs(f:GetChildren()) do
		if c:IsA("Model") then table.insert(t, c) end
	end
	return t
end

local function getKillers() return folderKids("Killers") end
local function getSurvivors() return folderKids("Survivors") end

-- ============================================================
-- ESP HIGHLIGHTS (only outline, nothing else)
-- ============================================================
local highlights = {}

local function clearHL(m)
	if highlights[m] then
		pcall(function() highlights[m]:Destroy() end)
		highlights[m] = nil
	end
end

local function applyHL(model, color)
	if not model or not model.Parent then return end
	local h = highlights[model]
	if not h or not h.Parent then
		h = Instance.new("Highlight")
		h.Name = "HS_HL"
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.FillTransparency = 0.65
		h.OutlineTransparency = 0
		h.Parent = model
		highlights[model] = h
	end
	h.FillColor, h.OutlineColor, h.Adornee = color, color, model
end

local function removeHLOnly(model)
	if highlights[model] then
		pcall(function() highlights[model]:Destroy() end)
		highlights[model] = nil
	end
end

function shouldSkip(model)
	if model == LocalPlayer.Character then return true end
	if not S.TeamCheck then return false end
	local myChar = LocalPlayer.Character
	if not myChar then return false end
	local myFolder = myChar.Parent and myChar.Parent.Name
	if not myFolder then return false end
	local theirFolder = model.Parent and model.Parent.Name
	return myFolder == theirFolder
end

local function refreshEsp()
	for m in pairs(highlights) do
		if not m.Parent then clearHL(m) end
	end

	for _, k in ipairs(getKillers()) do
		if shouldSkip(k) then
			clearHL(k)
		else
			local hrp = getRoot(k)
			local myRoot = getRoot(LocalPlayer.Character)
			if hrp and myRoot and (S.MaxEspDist == 0 or (hrp.Position - myRoot.Position).Magnitude <= S.MaxEspDist) then
				if S.KillerEsp then applyHL(k, S.KillerColor) else removeHLOnly(k) end
			else
				clearHL(k)
			end
		end
	end
	for _, s in ipairs(getSurvivors()) do
		if shouldSkip(s) then
			clearHL(s)
		else
			local hrp = getRoot(s)
			local myRoot = getRoot(LocalPlayer.Character)
			if hrp and myRoot and (S.MaxEspDist == 0 or (hrp.Position - myRoot.Position).Magnitude <= S.MaxEspDist) then
				if S.SurvivorEsp then applyHL(s, S.SurvivorColor) else removeHLOnly(s) end
			else
				clearHL(s)
			end
		end
	end
end

