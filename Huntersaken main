local genHLs, itemHLs, trapHLs = {}, {}, {}

local function clearHighlight(tbl, inst)
	if tbl[inst] then
		pcall(function() tbl[inst]:Destroy() end)
		tbl[inst] = nil
	end
end

local function makeHighlight(tbl, inst, color, fillTrans)
	if not inst or not inst.Parent then return end
	local h = tbl[inst]
	if h and h.Parent then
		h.FillColor = color
		h.OutlineColor = color
		return h
	end
	h = Instance.new("Highlight")
	h.Name = "HA_HL"
	h.Adornee = inst
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.FillColor = color
	h.OutlineColor = color
	h.FillTransparency = fillTrans or 0.5
	h.OutlineTransparency = 0
	h.Parent = inst
	tbl[inst] = h
	return h
end

local function getGeneratorProgress(gen)
	local p = gen:FindFirstChild("Progress")
	if p and typeof(p.Value) == "number" then return p.Value end
	return nil
end

local function isGenerator(inst)
	if not inst or not inst.Parent then return false end
	local n = inst.Name
	return n == "Generator" or n == "FakeGenerator" or n == "Fake Generator"
end

local function genColor(gen)
	if gen.Name == "FakeGenerator" or gen.Name == "Fake Generator" then
		return S.FakeGeneratorColor
	end
	local p = getGeneratorProgress(gen)
	if p and p >= 100 then return S.DoneGeneratorColor end
	return S.GeneratorColor
end

local ITEM_NAMES = { BloxyCola = true, Medkit = true, ["Med Kit"] = true }

local function isItem(inst)
	return inst and inst.Parent and ITEM_NAMES[inst.Name] == true
end

local function isTrap(inst)
	if not inst or not inst.Parent then return false end
	local n = inst.Name
	if n == "SubspaceTripmine" then return true end
	if n == "BearTrap" or n == "Trap" then return true end
	if inst:FindFirstChild("Wire") then return true end
	return false
end

local function getIngame()
	return Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Ingame")
		or Workspace:FindFirstChild("Ingame")
end

local function scanGenerators()
	local roots = {}
	local ingame = getIngame()
	local map = ingame and ingame:FindFirstChild("Map")
	if map then table.insert(roots, map) end
	if ingame then table.insert(roots, ingame) end
	table.insert(roots, Workspace)

	local seen = {}
	for _, root in ipairs(roots) do
		for _, child in ipairs(root:GetChildren()) do
			if isGenerator(child) and not seen[child] then
				seen[child] = true
				if S.GeneratorEsp then
					makeHighlight(genHLs, child, genColor(child), 0.5)
				else
					clearHighlight(genHLs, child)
				end
			end
		end
	end
end

local function scanItems()
	local roots = {}
	local ingame = getIngame()
	local map = ingame and ingame:FindFirstChild("Map")
	if map then table.insert(roots, map) end
	if ingame then table.insert(roots, ingame) end
	table.insert(roots, Workspace)

	local seen = {}
	for _, root in ipairs(roots) do
		for _, child in ipairs(root:GetChildren()) do
			if isItem(child) and not seen[child] then
